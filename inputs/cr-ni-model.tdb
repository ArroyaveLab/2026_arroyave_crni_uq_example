$ Cr-Ni model of Kunselman, Bocklund, Otis, Arroyave, Acta Mater. 315 (2026) 122412,
$ table tab:cr_ni_details: liquid 0L, BCC_A2 0L and 1L, FCC_A1 0L and 1L, each a+b*T.
$ Pure-element lattice stabilities: SGTE unary (SGTE91) functions exactly as ESPEI
$ writes them for ref_state SGTE91 (copied from the chapter's cr-ni_gen.tdb); fixed,
$ never fitted. No magnetic terms (as in the paper's ESPEI model).
$ VV symbols are the fitted parameters; values below are the paper's START values.
$ VV0000,VV0001 = a,b of L0 LIQUID ; VV0002,VV0003 = a,b of L0 BCC_A2
$ VV0004,VV0005 = a,b of L1 BCC_A2 ; VV0006,VV0007 = a,b of L0 FCC_A1
$ VV0008,VV0009 = a,b of L1 FCC_A1
ELEMENT CR BCC_A2 51.996 4050.0 23.56 !
ELEMENT NI FCC_A1 58.69 4787.0 29.796 !
ELEMENT VA VACUUM 0.0 0.0 0.0 !

FUNCTION GBCCCR 298.15 GHSERCR; 6000.0 N !
FUNCTION GBCCNI 298.15 8715.084+GHSERNI-3.556*T; 3000.0 N !
FUNCTION GFCCCR 298.15 7284+0.163*T+GHSERCR; 6000.0 N !
FUNCTION GFCCNI 298.15 GHSERNI; 3000.0 N !
FUNCTION GHSERCR 298.15 -8856.94+139250*T**(-1)+0.00189435*T**(2)+157.48*T
  -1.47721E-06*T**(3)-26.908*T*LOG(T); 2180.0 Y -34869.344
  -2.88526E+32*T**(-9)+344.18*T-50*T*LOG(T); 6000.0 N !
FUNCTION GHSERNI 298.15 -5179.159-22.096*T*LOG(T)-0.0048407*T**(2)+117.854*T;
   1728.0 Y -27840.655+1.12754E+31*T**(-9)+279.135*T-43.1*T*LOG(T); 3000.0 N !
FUNCTION GLIQCR 298.15 24339.955+2.37615E-21*T**(7)-11.420225*T+GHSERCR;
   2180.0 Y -16459.984+335.616316*T-50*T*LOG(T); 6000.0 N !
FUNCTION GLIQNI 298.15 16414.686-3.82318E-21*T**(7)+GHSERNI-9.397*T; 1728.0 Y
   -9549.775+268.598*T-43.1*T*LOG(T); 3000.0 N !
FUNCTION VV0000 1 -13886.1; 10000 N !
FUNCTION VV0001 1 4.632; 10000 N !
FUNCTION VV0002 1 9545.6; 10000 N !
FUNCTION VV0003 1 -4.222; 10000 N !
FUNCTION VV0004 1 47004.2; 10000 N !
FUNCTION VV0005 1 -11.221; 10000 N !
FUNCTION VV0006 1 10224.7; 10000 N !
FUNCTION VV0007 1 -8.477; 10000 N !
FUNCTION VV0008 1 36724.5; 10000 N !
FUNCTION VV0009 1 -15.324; 10000 N !

TYPE_DEFINITION % SEQ * !
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
DEFAULT_COMMAND DEFINE_SYSTEM_ELEMENT VA !

PHASE BCC_A2 %  1 1 !
CONSTITUENT BCC_A2 :CR, NI: !
PHASE FCC_A1 %  1 1 !
CONSTITUENT FCC_A1 :CR, NI: !
PHASE LIQUID %  1 1 !
CONSTITUENT LIQUID :CR, NI: !

PARAMETER G(BCC_A2,CR;0) 1 GBCCCR; 10000 N !
PARAMETER G(FCC_A1,CR;0) 1 GFCCCR; 10000 N !
PARAMETER G(LIQUID,CR;0) 1 GLIQCR; 10000 N !
PARAMETER G(BCC_A2,NI;0) 1 GBCCNI; 10000 N !
PARAMETER G(FCC_A1,NI;0) 1 GFCCNI; 10000 N !
PARAMETER G(LIQUID,NI;0) 1 GLIQNI; 10000 N !

PARAMETER L(LIQUID,CR,NI;0) 1 VV0000+VV0001*T; 10000 N !
PARAMETER L(BCC_A2,CR,NI;0) 1 VV0002+VV0003*T; 10000 N !
PARAMETER L(BCC_A2,CR,NI;1) 1 VV0004+VV0005*T; 10000 N !
PARAMETER L(FCC_A1,CR,NI;0) 1 VV0006+VV0007*T; 10000 N !
PARAMETER L(FCC_A1,CR,NI;1) 1 VV0008+VV0009*T; 10000 N !
